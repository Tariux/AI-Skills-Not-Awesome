#!/usr/bin/env bash
# whizbang-execute: Generate review package for a commit range
# Usage: review-package PLAN_FILE BASE HEAD
# Prints: path to review package

set -euo pipefail

if [ $# -ne 3 ]; then
  echo "usage: review-package PLAN_FILE BASE HEAD" >&2
  exit 2
fi

plan=$1
base=$2
head=$3
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

repo=$(git rev-parse --show-toplevel)
git -C "$repo" rev-parse --verify --quiet "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }
git -C "$repo" rev-parse --verify --quiet "$head" >/dev/null || { echo "bad HEAD: $head" >&2; exit 2; }
git -C "$repo" merge-base --is-ancestor "$base" "$head" || { echo "HEAD is not a descendant of BASE" >&2; exit 3; }

# Find workspace
dir=$(grep -l "$plan" "$repo/.whizbang/exec"/*/plan-path 2>/dev/null | head -1 | xargs dirname)
[ -n "$dir" ] || { echo "workspace not found for plan: $plan" >&2; exit 1; }

out="$dir/review-$(git -C "$repo" rev-parse --short "$base")..$(git -C "$repo" rev-parse --short "$head").diff"

{
  echo "# Review package: ${base}..${head}"
  echo
  echo "## Commits"
  git -C "$repo" log --oneline "${base}..${head}"
  echo
  echo "## Files changed"
  git -C "$repo" diff --stat "${base}..${head}"
  echo
  echo "## Diff"
  git -C "$repo" diff -U10 "${base}..${head}"
} > "$out"

commits=$(git -C "$repo" rev-list --count "${base}..${head}")
echo "wrote ${out}: ${commits} commit(s), $(wc -c < "$out" | tr -d ' ') bytes"